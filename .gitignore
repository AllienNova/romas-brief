# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-integrity

# Build artifacts (root-anchored to avoid swallowing docs/build/)
dist/
/build/
apps/*/build/
apps/*/dist/
workers/*/dist/
packages/*/dist/
!docs/build/
.next/
.nuxt/
out/
.cache/
.turbo/
.parcel-cache/
.vite/
.swc/
*.tsbuildinfo

# Cloudflare Workers
.wrangler/
.dev.vars
wrangler.toml.local

# Supabase
.supabase/
supabase/.temp/

# Audio smoke-test generated artifacts (audio files + measurement JSON)
tools/audio/output/

# Env / secrets — NEVER commit
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test coverage
coverage/
.nyc_output/
*.lcov

# IDE / editor
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# OS
.AppleDouble
.LSOverride
$RECYCLE.BIN/
*.lnk

# Python (translation tooling, if any)
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Audio working files (only finals go to R2; locally these are scratch)
*.wav
*.aif
*.aiff
audio-scratch/
audio-masters/

# DB local snapshots
*.sql.gz
*.dump
*.db

# Generated docs
.docusaurus/

# Misc
.history/
*.bak
*.bak.*
*.tmp
.DS_Store

# Repo hygiene (SHIP-05) — local-only artifacts, never committed
# Git bundles are local repo backups; delete manually if you don't want them.
*.bundle
# Legacy / archived code kept locally for reference, not part of the build.
_legacy/

# Playwright MCP device-test artifacts
.playwright-mcp/
