{
  "name": "romas-brief",
  "private": true,
  "version": "0.0.0",
  "description": "ROMAS Wire — the public media surface of ROMAS Intelligence. Daily Mon–Fri brief on radiation oncology. Monorepo (pnpm workspaces + Turborepo).",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=6.24.0",
      "glob": ">=10.5.0",
      "postcss": ">=8.5.10",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "esbuild@<=0.24.2": ">=0.25.0"
    }
  }
