[
  {
    "AllowedOrigins": [
      "https://romasbrief.com",
      "https://www.romasbrief.com",
      "http://localhost:3000"
    ],
    "AllowedMethods": ["GET", "HEAD"],
    "AllowedHeaders": ["Range", "If-Range", "If-None-Match", "If-Modified-Since"],
    "ExposeHeaders": [
      "Content-Length",
      "Content-Range",
      "Content-Type",
      "ETag",
      "Accept-Ranges",
      "Last-Modified"
    ],
    "MaxAgeSeconds": 3600
  }
]
