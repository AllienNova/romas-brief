# ROMAS Wire — environment variable manifest (M0 cycle-1)
# Per SSOT §3 row 13 + deployment-plan §5 secrets table.
# Copy this file to .env and fill in real values. NEVER commit .env.
# Rotation: 90 days routine; immediate on personnel change or suspected exposure.
# All production secrets live in Cloudflare Worker Secrets (not .env).

# =====================================================================
# Audio production (ADR-0004 ElevenLabs primary; ADR-0011 Whisper)
# TTS failover = Jellypod (ADR-0018 ACCEPTED 2026-06-03 — Q-F closed; PlayHT shut down
# 2025-12-31, PLAYHT_* removed in SHIP-14). On ElevenLabs failure the audio-producer
# submits a single-host Jellypod episode (JELLYPOD_FAILOVER_HOST_ID) and polls for the MP3.
# =====================================================================
ELEVENLABS_API_KEY=
# Per D-032 (2026-05-22): 3 ElevenLabs Creator-tier voices by tier role.
# Replaces the single ELEVENLABS_ROMAS_VOICE_ID (Kimal clone deferred post-launch).
ELEVENLABS_VOICE_ID_BRIEF=
ELEVENLABS_VOICE_ID_PODCAST=
ELEVENLABS_VOICE_ID_CONFERENCE=
# Jellypod — Tier-3 full-length conversational podcast generation (audio only).
# API: Bearer key (sk_…) from dashboard → Settings → API Keys. See Docs/specs/podcast-video-pipeline.md
JELLYPOD_API_KEY=
JELLYPOD_PODCAST_ID=
# Single-host voice for TTS failover of the ElevenLabs tiers (ADR-0018).
JELLYPOD_FAILOVER_HOST_ID=
# Bearer authenticating the podcast-generator POST /generate trigger (openssl rand -hex 32).
PODCAST_GENERATOR_SECRET=
# Loudness mastering microservice (REQUIRED — SHIP-14: jobs fail-closed/skip if unset).
LOUDNORM_ENDPOINT=
WHISPER_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
OPENAI_API_KEY=

# =====================================================================
# Supabase (ADR-0002)
# =====================================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NoticeBoard on-demand cache revalidation (POST /api/internal/revalidate-board).
# Bearer token authorizing notices-board tag invalidation. Generate: openssl rand -hex 32
ROMAS_REVALIDATE_SECRET=

# =====================================================================
# Cloudflare (ADR-0003)
# =====================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
# R2 S3-compatible access (audio-producer / R2 SDK). Endpoint = https://<account>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# R2-scoped Cloudflare API token (bucket management) — distinct from CLOUDFLARE_API_TOKEN (zone/account scope)
R2_API_TOKEN=
R2_ARCHIVE_BUCKET=romas-audio-archive
R2_CDN_BUCKET=romas-audio-cdn

# =====================================================================
# Email — Beehiiv (newsletter) + Resend (transactional) per ADR-0007 cycle-3
# =====================================================================
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# =====================================================================
# LATAM editorial — DeepL Pro (ADR-0013 cycle-6)
# NOTE: MUST be Pro tier (not Free) — 30-day retention on Free violates editorial workflow.
# =====================================================================
DEEPL_API_KEY=

# =====================================================================
# Observability (ADR-0008)
# =====================================================================
SENTRY_DSN=
PLAUSIBLE_DOMAIN=romasbrief.com

# =====================================================================
# Development mode
# =====================================================================
NODE_ENV=development
