{
  "$schema": "https://schemas.romasbrief.com/design-tokens/v1.json",
  "version": "1.2.0",
  "lastUpdated": "2026-05-15 (M0c2 design-QA contrast fix — superseded v1.1.0)",
  "supersedes": "v1.1.0 (had 9 P0 WCAG contrast failures per docs/qa/design-review.md)",
  "authority": "Canonical CSS variables live in .claude/skills/design-tokens.md v1.2. This JSON mirror is generated for cross-platform consumption (Tailwind, iOS asset catalog, Android theme resources).",
  "color": {
    "brand": {
      "bg":          { "value": "#FAFAF8", "css": "--rb-bg",          "desc": "Off-white page background" },
      "bg-elevated": { "value": "#FFFFFF", "css": "--rb-bg-elevated", "desc": "Card / surface background" },
      "ink":         { "value": "#0E1116", "css": "--rb-ink",         "desc": "Primary text",                                              "contrast-on-bg": "18.10:1 (AAA Normal · measured M0c2)" },
      "ink-muted":   { "value": "#4A5159", "css": "--rb-ink-muted",   "desc": "Muted text / metadata · standfirst",                        "contrast-on-bg": "7.69:1 (AAA Normal)" },
      "ink-subtle":  { "value": "#6B7280", "css": "--rb-ink-subtle",  "desc": "Subtle text / labels (v1.2: was #6E767E FAIL; now PASS AA)", "contrast-on-bg": "4.55:1 (AA Normal · measured M0c2)" },
      "rule":        { "value": "#E5E7EB", "css": "--rb-rule",        "desc": "Hairline borders" },
      "accent":      { "value": "#00B4C6", "css": "--rb-accent",      "desc": "ROMAS teal — FILLS ONLY (logo dot · large UI surfaces). BANNED as text or focus-ring; design-system-keeper blocks.", "contrast-on-bg": "2.41:1 (FAIL AA Large)" },
      "accent-deep": { "value": "#0090A0", "css": "--rb-accent-deep", "desc": "Hover · large-fill (≥ 24px regular or ≥ 18.66px bold) only", "contrast-on-bg": "3.66:1 (AA Large only)" },
      "accent-strong":{"value": "#006B7A", "css": "--rb-accent-strong","desc": "v1.2 NEW: text · focus-ring · non-text UI on bg",          "contrast-on-bg": "5.91:1 (AA Normal · measured M0c2)" },
      "accent-soft": { "value": "#D5F2F5", "css": "--rb-accent-soft", "desc": "Accent surface tint · ROMAS Insight callout bg" }
    },
    "audio-state": {
      "_v12_note": "M0c2 v1.2 split: original values for decorative dot + large-fill backgrounds (aria-hidden when used as dot); new -text variants for badge LABEL foreground that pass AA Normal contrast on their respective badge bg.",
      "published":      { "value": "#00B4C6", "css": "--rb-audio-published",      "desc": "Audio is live — decorative dot/fill ONLY",        "label-required": true, "text-token": "--rb-audio-published-text" },
      "published-text": { "value": "#006B7A", "css": "--rb-audio-published-text", "desc": "v1.2 NEW: 'Listen' badge label",                  "contrast-on-accent-soft": "5.16:1 (AA Normal)" },
      "pending":        { "value": "#F59E0B", "css": "--rb-audio-pending",        "desc": "queued/generating/in_review — decorative dot/fill", "label-required": true, "text-token": "--rb-audio-pending-text" },
      "pending-text":   { "value": "#B45309", "css": "--rb-audio-pending-text",   "desc": "v1.2 NEW: pending badge label",                   "contrast-on-amber-50": "4.83:1 (AA Normal)" },
      "skipped":        { "value": "#94A3B8", "css": "--rb-audio-skipped",        "desc": "No audio for this brief — decorative dot/fill",   "label-required": true, "text-token": "--rb-audio-skipped-text" },
      "skipped-text":   { "value": "#475569", "css": "--rb-audio-skipped-text",   "desc": "v1.2 NEW: skipped badge label",                   "contrast-on-slate-100": "5.85:1 (AA Normal)" },
      "revoked":        { "value": "#DC2626", "css": "--rb-audio-revoked",        "desc": "Audio withdrawn — decorative dot/fill",           "label-required": true, "text-token": "--rb-audio-revoked-text" },
      "revoked-text":   { "value": "#B91C1C", "css": "--rb-audio-revoked-text",   "desc": "v1.2 NEW: revoked badge label",                   "contrast-on-red-50": "5.83:1 (AA Normal)" }
    },
    "semantic": {
      "success": { "value": "#16A34A", "css": "--rb-success" },
      "warning": { "value": "#F59E0B", "css": "--rb-warning" },
      "danger":  { "value": "#DC2626", "css": "--rb-danger" },
      "info":    { "value": "#2563EB", "css": "--rb-info" }
    },
    "dark-mode-override": {
      "bg":           "#0B0E12",
      "bg-elevated":  "#121620",
      "ink":          "#F5F6F7",
      "ink-muted":    "#B0B6BD",
      "ink-subtle":   "#9CA3AF",
      "rule":         "#1F242B",
      "accent-soft":  "#0A2F33",
      "_v12_dark_note": "ink-subtle in dark mode was #7C848D (verify ≥ 4.5:1 on #0B0E12 in W-6 prototype); v1.2 tightened to #9CA3AF for safety pending run-time verification"
    }
  },
  "typography": {
    "family": {
      "sans":  "Inter, system-ui, -apple-system, sans-serif",
      "serif": "Source Serif Pro, Georgia, serif",
      "mono":  "JetBrains Mono, ui-monospace, monospace"
    },
    "scale": {
      "xs":   { "size": "0.75rem",  "px": 12, "line-height": 1.5  },
      "sm":   { "size": "0.875rem", "px": 14, "line-height": 1.5  },
      "base": { "size": "1rem",     "px": 16, "line-height": 1.65, "use": "article body baseline (serif)" },
      "lg":   { "size": "1.125rem", "px": 18, "line-height": 1.5,  "use": "standfirst (serif italic)" },
      "xl":   { "size": "1.25rem",  "px": 20, "line-height": 1.4  },
      "2xl":  { "size": "1.5rem",   "px": 24, "line-height": 1.35 },
      "3xl":  { "size": "2rem",     "px": 32, "line-height": 1.25, "use": "article title" },
      "4xl":  { "size": "2.5rem",   "px": 40, "line-height": 1.15 },
      "5xl":  { "size": "3.25rem",  "px": 52, "line-height": 1.05, "use": "hero only" }
    },
    "weight": {
      "regular": 400,
      "medium":  500,
      "semibold": 600,
      "bold":     700
    },
    "max-measure": {
      "prose": "66ch",
      "desc":  "Article body max width. Never wider on prose blocks."
    }
  },
  "spacing": {
    "1":  "0.25rem",
    "2":  "0.5rem",
    "3":  "0.75rem",
    "4":  "1rem",
    "5":  "1.25rem",
    "6":  "1.5rem",
    "8":  "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem",
    "sponsor-firewall": {
      "value": "2rem",
      "px": 32,
      "locked": true,
      "desc":   "Minimum distance between sponsor block and ROMAS Brief wordmark. PR-blocked if violated."
    }
  },
  "radius": {
    "sm":   "4px",
    "default": "8px",
    "lg":   "12px",
    "xl":   "16px",
    "pill": "9999px"
  },
  "shadow": {
    "1": "0 1px 2px rgba(14,17,22,0.06)",
    "2": "0 4px 12px rgba(14,17,22,0.08)",
    "3": "0 12px 32px rgba(14,17,22,0.10)",
    "discipline": "Default to hairline border (rb-rule) for cards. Shadow-1 reserved for elevation moments. Shadow-3 modal only. No shadows on flat layouts."
  },
  "motion": {
    "ease":     "cubic-bezier(0.2, 0.6, 0.2, 1)",
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "reduced-motion": "All non-essential animation suppressed under prefers-reduced-motion. AudioPlayer waveform → static. Skeleton shimmer → static gray. Modal cross-fade → instant. Scroll-triggered → none."
  },
  "breakpoints": {
    "mobile-s": 320,
    "mobile":   390,
    "mobile-l": 414,
    "tablet":   768,
    "laptop":   1024,
    "desktop":  1440
  },
  "grid": {
    "mobile":  { "columns": 1,  "gutter": "16px" },
    "tablet":  { "columns": 6,  "gutter": "16px" },
    "laptop":  { "columns": 12, "gutter": "24px" },
    "desktop": { "columns": 12, "gutter": "24px" },
    "max-container": "1280px"
  },
  "focus-ring": {
    "outline":     "2px solid var(--rb-accent-strong)",
    "offset":      "3px",
    "radius":      "4px",
    "contrast-on-bg": "5.91:1 (PASS WCAG 1.4.11 non-text UI 3:1 + 2.4.7 focus visible)",
    "v12-fix":     "Was 'var(--rb-accent)' (2.41:1 FAIL); changed to '--rb-accent-strong' per docs/qa/design-review.md P0-D5",
    "discipline":  ":focus-visible only; not on :focus. Mandatory on every interactive element."
  },
  "z-index": {
    "modal":         50,
    "toast":         40,
    "audio-banner":  30,
    "sticky-header": 20,
    "dropdown":      10
  },
  "logo": {
    "variant": "c",
    "wordmark": "ROMAS BRIEF",
    "font":     "Inter 700, letter-spacing -0.02em",
    "ink":      "var(--rb-ink)",
    "accent":   "Teal disk replaces dot of 'i' in BRIEF; radius 50%; doubles as favicon. Decorative use only — not contrast-critical (no text on the disk).",
    "forbidden": [
      "Sponsor logo within 32px of wordmark",
      "Co-branded mastheads (Day 1–90)",
      "Chevron-cursor mark (deferred per v1.1 lock)"
    ]
  }
}
